---
import { rulers, timeline, eras, START_YEAR, END_YEAR } from "../data/timeline";
import { painters } from "../data/painters";
import { events } from "../data/events";
import "../styles/timeline.css";
import { entries } from "../data/entries";
interface Props {
  selected?: (typeof entries)[number];
}
const { selected } = Astro.props;
const extraPickers = [
  { kind: "event", label: "Найти событие", list: events },
  { kind: "painter", label: "Найти художника", list: painters },
];
const scale = 8;
const ticks = Array.from(
  { length: Math.floor((END_YEAR - 860) / 5) + 1 },
  (_, i) => 860 + i * 5,
).filter((y) => y >= START_YEAR);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Russia History Timeline — история России на общей шкале времени: правители, важнейшие события и известные художники. Сравнивайте эпохи, меняйте масштаб и узнавайте о современниках."
    />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{selected ? `${selected.name} — Russia History Timeline` : "Russia History Timeline"}</title>
  </head>
  <body>
    <a class="skip-link" href="#timeline">
      К линии времени
    </a>
    <header class="masthead">
      <a class="brand" href="/" aria-label="Russia History Timeline — главная">
        <span class="brand-mark" aria-hidden="true">
          Р
        </span>{" "}
        <span lang="en">Russia History Timeline</span>
      </a>
      <span class="edition">ОТ РЮРИКА ДО НАШИХ ДНЕЙ</span>
    </header>
    <main>
      <section class="intro" aria-labelledby="page-title">
        <div class="intro-copy">
          <p class="eyebrow">
            <span></span> 862 — {new Date().getFullYear()} · ЛЮДИ, СОБЫТИЯ И ИСКУССТВО
          </p>
          <h1 id="page-title" lang="en">
            Russia History <em>Timeline</em>
          </h1>
          <p class="lead">
            Власть, события и живопись на одной шкале времени.
            <br />
            Узнайте, кто жил в одну эпоху.
          </p>
        </div>
        <figure class="historical-image">
          <img
            src="/varangians.jpg"
            alt="Виктор Васнецов. Призвание варягов: встреча князя и посланников"
            width="600"
            height="300"
            fetchpriority="high"
          />
          <figcaption>В. М. Васнецов · «Призвание варягов»</figcaption>
        </figure>
      </section>

      <section class="atlas" aria-label="Интерактивная линия истории">
        <div class="atlas-topline">
          <h2>Линия истории</h2>
          <span>
            {rulers.length} правлений <span class="separator">/</span> 6 эпох
          </span>
        </div>
        <nav class="era-nav" aria-label="Перейти к эпохе">
          {eras.map((era, i) => (
            <button
              type="button"
              class="era-button"
              data-era={era.id}
              data-year={era.start}
              aria-pressed={i === 0 ? "true" : "false"}
              style={`--era-color:${era.color}`}
            >
              <span class="era-dot" />
              {era.name}
            </button>
          ))}
        </nav>
        <div class="toolbar">
          <div class="range-heading">
            <span class="eyebrow">В ПОЛЕ ЗРЕНИЯ</span>
            <output id="visible-years">862 — 962</output>
          </div>
          <label class="ruler-picker">
            <span>Найти правителя</span>
            <select id="ruler-picker">
              <option value="">Выберите имя</option>
              {timeline.map((r) => (
                <option value={r.id}>
                  {r.kind === "context" ? "Период: " : ""}
                  {r.name} · {r.dates}
                </option>
              ))}
            </select>
          </label>
          <div class="zoom-control">
            <div class="zoom-label">
              <label for="zoom">Масштаб</label>
              <output id="scale-label">×4</output>
            </div>
            <div class="zoom-input">
              <button
                id="zoom-out"
                type="button"
                aria-label="Уменьшить масштаб"
              >
                −
              </button>
              <input
                id="zoom"
                type="range"
                min="0"
                max="7"
                value="2"
                step="1"
                aria-label="Масштаб линии времени"
              />
              <button id="zoom-in" type="button" aria-label="Увеличить масштаб">
                +
              </button>
            </div>
          </div>
        </div>
        <div class="entity-tools">
          {extraPickers.map(({ kind, label, list }) => (
            <label class="ruler-picker">
              <span>{label}</span>
              <select id={`${kind}-picker`}>
                <option value="">Выберите из списка</option>
                {list.map((item) => (
                  <option value={item.id}>
                    {item.name} · {item.dates}
                  </option>
                ))}
              </select>
            </label>
          ))}
          <ul class="timeline-legend" aria-label="Обозначения на линии времени">
            <li data-category="ruler">Правители</li>
            <li data-category="event">События</li>
            <li data-category="painter">Художники</li>
          </ul>
        </div>
        <div
          class="timeline-viewport"
          id="timeline"
          tabindex="0"
          role="region"
          aria-label="Правители, события и художники по годам. Прокручивайте по горизонтали и вертикали."
          aria-describedby="timeline-help"
        >
          <div
            class="timeline-track"
            id="timeline-track"
            style={`--scale:${scale}px;--years:${END_YEAR - START_YEAR}`}
          >
            <div class="year-axis" aria-hidden="true">
              {ticks.map((year) => (
                <span
                  class="year-tick"
                  data-year={year}
                  data-major={year % 50 === 0 ? "true" : "false"}
                  style={`left:calc((${year} - ${START_YEAR}) * var(--scale))`}
                >
                  <span>{year}</span>
                </span>
              ))}
            </div>
            {entries.map((entry, index) => (
              <a
                href={`/${entry.id}/`}
                id={entry.id}
                class:list={[
                  "timeline-card",
                  { "context-period": entry.kind === "context" },
                ]}
                data-category={entry.category}
                data-ruler={entry.category === "ruler" ? entry.id : undefined}
                data-event={entry.category === "event" ? entry.id : undefined}
                data-painter={
                  entry.category === "painter" ? entry.id : undefined
                }
                data-start={entry.start}
                data-end={entry.end}
                aria-label={`${entry.name}, ${entry.dates}. Открыть справку`}
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="ruler-preview"
                style={`left:calc((${entry.start} - ${START_YEAR}) * var(--scale));top:${64 + index * 104}px;width:max(200px, calc(${entry.end - entry.start} * var(--scale)))`}
              >
                <span class="card-copy">
                  <span class="card-meta">
                    {entry.label} · {entry.dates}
                  </span>
                  <strong>{entry.name}</strong>
                </span>
                <span
                  class="card-duration"
                  aria-hidden="true"
                  style={`width:calc(${entry.end - entry.start} * var(--scale))`}
                ></span>
              </a>
            ))}
          </div>
        </div>
        <p class="timeline-note">
          Цветная полоса — длительность правления, события или жизни; карточка
          может быть шире короткого периода. Художники и события — выборочная
          подборка. Годы жизни включают детство и жизнь за рубежом;
          приблизительные даты отмечены «ок.».
        </p>
        <div class="timeline-bottom">
          <p id="timeline-help">
            <span aria-hidden="true">↔</span> Листайте по горизонтали.{" "}
            <span class="desktop-help">
              Нажмите на карточку — узнайте больше.
            </span>
            <span class="touch-help">
              Нажмите на карточку — узнайте больше.
            </span>
          </p>
          <div class="step-controls">
            <button type="button" id="pan-back" aria-label="Раньше">
              ←
            </button>
            <button type="button" id="pan-forward" aria-label="Позже">
              →
            </button>
          </div>
        </div>
        <div class="overview">
          <div class="overview-label">
            <label for="position">Вся история</label>
            <span>862 — {new Date().getFullYear()}</span>
          </div>
          <div class="overview-map" aria-hidden="true">
            {eras.map((e) => (
              <span style={`flex:${e.end - e.start};background:${e.color}`} />
            ))}
            <span id="overview-window"></span>
          </div>
          <input
            id="position"
            type="range"
            min="0"
            max="1000"
            value="0"
            aria-label="Положение на линии времени"
          />
        </div>
      </section>

      <footer class="page-footer">
        <span class="footer-monogram" aria-hidden="true">
          Р
        </span>
        <div>
          <p>История не всегда движется по прямой.</p>
          <p class="editorial-note">
            До возвышения Москвы показаны основные князья, а не все претенденты.
            Штрихованные отрезки объясняют смену князей, междуцарствие или
            переход к другому центру власти. Это не годы без правителей.
            Перерывы и соправление поясняются в справках. В 1991 году
            руководства СССР и РСФСР существовали одновременно. Длина отрезка
            передаёт время, а не значение правителя.
          </p>
          <details>
            <summary>О датах и источниках</summary>
            <p>
              Даты ранней Руси следуют летописной традиции и могут быть
              спорными. Краткие правления внутри года размещены приблизительно.
              Советская линия показывает политических руководителей, а не только
              формальных глав государства. Современные сведения — на сентябрь
              2026 года.
            </p>
            <p>
              Живописцы разных культур включены по связи с Русью, Российской
              империей, СССР или Россией, а не по единой национальности.
              Биографии:{" "}
              <a
                href="https://my.tretyakov.ru/"
                target="_blank"
                rel="noreferrer"
              >
                Третьяковская галерея
              </a>
              ,{" "}
              <a
                href="https://rusmuseumvrm.ru/"
                target="_blank"
                rel="noreferrer"
              >
                Русский музей
              </a>
              . Справочные материалы о правителях:{" "}
              <a
                href="https://history.ru/read/articles/pravitieli-rossii"
                target="_blank"
                rel="noreferrer"
              >
                Правители России · История.РФ
              </a>
              ,{" "}
              <a
                href="https://www.britannica.com/place/Russia/History"
                target="_blank"
                rel="noreferrer"
              >
                История России · Британника
              </a>
              ,{" "}
              <a
                href="https://litopys.org.ua/litop/kniazi.htm"
                target="_blank"
                rel="noreferrer"
              >
                Киевские князья · указатель к летописи
              </a>
              ,{" "}
              <a
                href="https://bigenc.ru/c/iziaslav-mstislavich-umer-1154-1d48af"
                target="_blank"
                rel="noreferrer"
              >
                Изяслав Мстиславич · БРЭ
              </a>
              . Тексты справок — краткое редакционное изложение.{" "}
              <a href="/artworks/CREDITS.txt" target="_blank" rel="noreferrer">
                Источники репродукций
              </a>
              . Даты под картинами — время их создания, а не обязательно время
              изображённых событий.
            </p>
          </details>
        </div>
      </footer>
      <noscript>
        <section class="no-script">
          <h2>События</h2>
          {events.map((e) => (
            <details>
              <>
                <summary>
                  {e.name} · {e.dates}
                </summary>
                <p>{e.intro}</p>
                <p>{e.outcome}</p>
              </>
            </details>
          ))}
          <h2>Художники</h2>
          {painters.map((p) => (
            <details>
              <>
                <summary>
                  {p.name} · {p.dates}
                </summary>
                <p>{p.intro}</p>
                <p>{p.connection}</p>
                <p>{p.works}</p>
              </>
            </details>
          ))}
          <h2>Краткие справки о правителях</h2>
          <p>
            Для изменения масштаба включите JavaScript. Все справки доступны
            ниже.
          </p>
          {timeline.map((r) => (
            <details>
              <>
                <summary>
                  {r.kind === "context" ? "Период: " : ""}
                  {r.name} · {r.dates}
                </summary>
                <>
                  <p>{r.intro}</p>
                  <dl class="succession">
                    <>
                      <dt>
                        {r.kind === "context"
                          ? "Начало периода"
                          : "Приход к власти"}
                      </dt>
                      <dd>{r.accession}</dd>
                      <dt>
                        {r.kind === "context"
                          ? "Чем завершился"
                          : "Завершение правления"}
                      </dt>
                      <dd>{r.departure}</dd>
                    </>
                  </dl>
                </>
              </>
            </details>
          ))}
        </section>
      </noscript>
    </main>
    <dialog
      id="ruler-preview"
      class="ruler-preview"
      role="dialog"
      aria-modal="true"
      aria-labelledby="preview-name"
      aria-describedby="preview-intro"
    >
      <div class="preview-top">
        <span id="preview-era" class="eyebrow"></span>
        <button type="button" id="close-preview" aria-label="Закрыть справку">
          ×
        </button>
      </div>
      <div class="preview-body">
        <p id="preview-dates"></p>
        <h2 id="preview-name"></h2>
        <p id="preview-title"></p>
        <section
          id="artwork-gallery"
          aria-label="Произведения искусства"
          hidden
        ></section>
        <p id="preview-intro"></p>
        <dl class="succession">
          <dt id="accession-label">Приход к власти</dt>
          <dd id="preview-accession"></dd>
          <dt id="departure-label">Завершение правления</dt>
          <dd id="preview-departure"></dd>
        </dl>
        <details id="contemporaries">
          <summary id="contemporaries-label"></summary>
          <p class="contemporary-note">
            Совпадение лет жизни и правления, а не свидетельство знакомства или
            работы при дворе. Внутри одного года и при приблизительных датах
            возможны неточности.
          </p>
          <div id="contemporary-links"></div>
        </details>
        <details id="related-events" hidden>
          <summary id="related-events-label">События и искусство</summary>
          <div id="event-links"></div>
        </details>
      </div>
      <div class="preview-bottom">
        <span id="preview-count"></span>
        <div>
          <button
            type="button"
            id="previous-ruler"
            aria-label="Предыдущий правитель"
          >
            ←
          </button>
          <button
            type="button"
            id="next-ruler"
            aria-label="Следующий правитель"
          >
            →
          </button>
        </div>
      </div>
    </dialog>
    <script>
      import "../scripts/timeline";
    </script>
  </body>
</html>
